# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Share this template with team members or commit to repository safely.
# Do NOT place actual passwords or secrets in this template file.
# ==============================================================================

HOSTING_PROVIDER=your_hosting_provider
HOSTING_ACCOUNT_ID=your_account_id
HOSTING_USER_ID=your_user_id
HOSTING_PASSWORD=your_password

FTP_HOST=ftp.yourdomain.com
FTP_USER=your_ftp_username
FTP_PASS=your_ftp_password
FTP_PORT=21

SSH_HOST=yourdomain.com
SSH_USER=your_ssh_username
SSH_PORT=22

DEPLOY_TOKEN=your_deploy_token
VERCEL_TOKEN=your_vercel_token
NETLIFY_AUTH_TOKEN=your_netlify_token
GITHUB_TOKEN=your_github_token

SITE_URL=https://yourdomain.com
APP_ENV=production
